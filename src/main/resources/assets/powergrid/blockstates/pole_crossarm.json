{
  "multipart": [
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_beam_x"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_beam_z"
      }
    },
    {
      "when": {
        "on_pole": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_top_cap"
      }
    },
    {
      "when": {
        "axis": "x",
        "neg_pole": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_bracket_neg_x"
      }
    },
    {
      "when": {
        "axis": "x",
        "pos_pole": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_bracket_pos_x"
      }
    },
    {
      "when": {
        "axis": "z",
        "neg_pole": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_bracket_neg_z"
      }
    },
    {
      "when": {
        "axis": "z",
        "pos_pole": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_bracket_pos_z"
      }
    },
    {
      "when": {
        "axis": "x",
        "neg_end": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_end_neg_x"
      }
    },
    {
      "when": {
        "axis": "x",
        "pos_end": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_end_pos_x"
      }
    },
    {
      "when": {
        "axis": "z",
        "neg_end": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_end_neg_z"
      }
    },
    {
      "when": {
        "axis": "z",
        "pos_end": "true"
      },
      "apply": {
        "model": "powergrid:block/pole_crossarm_end_pos_z"
      }
    }
  ]
}